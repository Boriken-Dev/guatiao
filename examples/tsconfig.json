{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "esnext.disposable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "types": ["node"],
    "typeRoots": ["../bindings/node_modules/@types"]
  },
  "files": [
    "greeter_kind/node/greeter_kind.ts",
    "node_provider/node_greeter/greeters.ts",
    "node_host/host.ts"
  ]
}
