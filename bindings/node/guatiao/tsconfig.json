{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024",
      "esnext.disposable"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "paths": {
      "guatiao": [
        "./src/index.ts"
      ],
      "guatiao/*": [
        "./src/*.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "../../../examples/greeter_kind/node/greeter_kind.d.ts",
    "../../../examples/tally_kind/tally_kind.ts",
    "../../../examples/tally_kind/node/tally_kind.d.ts",
    "../../../examples/node_host",
    "../../../examples/node_provider"
  ]
}
