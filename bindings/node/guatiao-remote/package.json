{
  "name": "guatiao-remote",
  "version": "0.0.0-alpha.1",
  "description": "guatiao's remote protocol from a browser page or any JavaScript program: providers a server serves, called over a WebSocket",
  "license": "MPL-2.0",
  "author": "jose-pr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boriken-Dev/guatiao.git",
    "directory": "bindings/node/guatiao-remote"
  },
  "homepage": "https://github.com/Boriken-Dev/guatiao/",
  "bugs": "https://github.com/Boriken-Dev/guatiao/issues",
  "keywords": ["rpc", "websocket", "browser", "plugins", "values"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
