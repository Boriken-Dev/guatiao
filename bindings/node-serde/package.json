{
  "name": "guatiao-serde",
  "version": "0.0.0-alpha.1",
  "description": "JSON, TOML and YAML for guatiao values, over the guatiao_serde C ABI",
  "license": "MPL-2.0",
  "author": "jose-pr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boriken-Dev/guatiao.git",
    "directory": "bindings/node-serde"
  },
  "homepage": "https://github.com/Boriken-Dev/guatiao/",
  "bugs": "https://github.com/Boriken-Dev/guatiao/issues",
  "keywords": ["json", "toml", "yaml", "values", "c-abi"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "guatiao": "0.0.0-alpha.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
