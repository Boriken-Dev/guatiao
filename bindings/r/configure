#!/bin/sh
# Finds libffi and writes src/Makevars from src/Makevars.in.

FFI_CFLAGS=""
FFI_LIBS="-lffi"
if pkg-config --exists libffi 2>/dev/null; then
  FFI_CFLAGS=$(pkg-config --cflags libffi)
  FFI_LIBS=$(pkg-config --libs libffi)
elif [ "$(uname)" = "Darwin" ]; then
  SDK=$(xcrun --show-sdk-path 2>/dev/null)
  if [ -n "$SDK" ] && [ -f "$SDK/usr/include/ffi/ffi.h" ]; then
    FFI_CFLAGS="-I$SDK/usr/include/ffi"
  fi
fi

OS_LIBS=""
if [ "$(uname)" = "Linux" ]; then
  OS_LIBS="-ldl -lpthread"
fi

sed -e "s|@FFI_CFLAGS@|$FFI_CFLAGS|" -e "s|@FFI_LIBS@|$FFI_LIBS|" -e "s|@OS_LIBS@|$OS_LIBS|" \
  src/Makevars.in > src/Makevars
