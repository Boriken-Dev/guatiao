# Checks C++ kind declarations against the kinds' description.
#
# A lent tree and one handed over are the same C pointer, so the compiler
# cannot tell `map_ref` from `map`, or `lent<K>` from `object<K>`; the
# description (`<crate>.kinds.json`) says which. Every `GUATIAO_KIND` and
# `GUATIAO_OBJECT_KIND` in a header (and their `_NAMED` forms, looked up by
# the name given) must name a described kind of the same sort and declare
# each of its slots, required or optional as described, with the signature
# the description spells:
#
#   argument                 C++                answer        C++
#   str / bytes / bytes_mut  string_view /      text          std::string
#                            bytes_view /       map/list/value  map/list/value
#                            bytes_mut          object of K   object<K>
#   tree, borrowed           view / map_view /  none          void
#                            list_view
#   tree, taken              value / map / list
#   tree, lent               node / map_ref / list_ref
#   object of K, taken/lent  object<K> / lent<K>
#   i8..i64, u8..u64         std::int8_t.., std::uint8_t..
#   isize / usize            std::ptrdiff_t / std::size_t
#   f32 / f64 / bool         float / double / bool
#
# Namespace qualifiers are ignored, so `guatiao::map` and `map` agree.
#
#   guatiao_check_kinds(<test name> HEADER <file> DESCRIPTION <file> [EXPECT <regex>])
#
# adds a test that fails on any difference, naming each; with EXPECT, one
# that passes only when the check's output matches <regex>. Relative paths
# are from the calling directory.
#
# Run as a script: cmake -DHEADER=<file> -DDESCRIPTION=<file> -P GuatiaoKindCheck.cmake

if(NOT CMAKE_SCRIPT_MODE_FILE)
  function(guatiao_check_kinds name)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "HEADER;DESCRIPTION;EXPECT" "")
    if(NOT arg_HEADER OR NOT arg_DESCRIPTION)
      message(FATAL_ERROR "guatiao_check_kinds(${name}) needs HEADER and DESCRIPTION")
    endif()
    # Relative to the calling directory: the test runs in the build tree.
    get_filename_component(header "${arg_HEADER}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(description "${arg_DESCRIPTION}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    add_test(NAME ${name}
             COMMAND "${CMAKE_COMMAND}" "-DHEADER=${header}" "-DDESCRIPTION=${description}"
                     -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    if(arg_EXPECT)
      set_tests_properties(${name} PROPERTIES PASS_REGULAR_EXPRESSION "${arg_EXPECT}")
    endif()
  endfunction()
  return()
endif()

# --- the check, in script mode -------------------------------------------

cmake_minimum_required(VERSION 3.19)

# The text from `open` (an index just past an opening parenthesis) to its
# matching close, and the index after that close.
function(_gk_balanced text open out_inner out_next)
  string(LENGTH "${text}" n)
  set(depth 1)
  set(i ${open})
  while(i LESS n)
    string(SUBSTRING "${text}" ${i} 1 c)
    if(c STREQUAL "(")
      math(EXPR depth "${depth} + 1")
    elseif(c STREQUAL ")")
      math(EXPR depth "${depth} - 1")
      if(depth EQUAL 0)
        math(EXPR len "${i} - ${open}")
        string(SUBSTRING "${text}" ${open} ${len} inner)
        math(EXPR next "${i} + 1")
        set(${out_inner} "${inner}" PARENT_SCOPE)
        set(${out_next} ${next} PARENT_SCOPE)
        return()
      endif()
    endif()
    math(EXPR i "${i} + 1")
  endwhile()
  message(FATAL_ERROR "${HEADER}: an unclosed parenthesis")
endfunction()

# `text` split at its top-level commas, each part trimmed, as a list. The
# parts hold no semicolons: a C++ declaration's own were removed with the
# statement ends.
function(_gk_split text out)
  string(LENGTH "${text}" n)
  set(parts "")
  set(depth 0)
  set(start 0)
  set(i 0)
  while(i LESS n)
    string(SUBSTRING "${text}" ${i} 1 c)
    if(c STREQUAL "(" OR c STREQUAL "<")
      math(EXPR depth "${depth} + 1")
    elseif(c STREQUAL ")" OR c STREQUAL ">")
      math(EXPR depth "${depth} - 1")
    elseif(c STREQUAL "," AND depth EQUAL 0)
      math(EXPR len "${i} - ${start}")
      string(SUBSTRING "${text}" ${start} ${len} part)
      string(STRIP "${part}" part)
      list(APPEND parts "${part}")
      math(EXPR start "${i} + 1")
    endif()
    math(EXPR i "${i} + 1")
  endwhile()
  string(SUBSTRING "${text}" ${start} -1 part)
  string(STRIP "${part}" part)
  list(APPEND parts "${part}")
  set(${out} "${parts}" PARENT_SCOPE)
endfunction()

# A C++ type as compared: no blanks, no namespace qualifiers.
function(_gk_bare type out)
  string(REGEX REPLACE "[ \t]+" "" type "${type}")
  string(REGEX REPLACE "[A-Za-z_][A-Za-z0-9_]*::" "" type "${type}")
  set(${out} "${type}" PARENT_SCOPE)
endfunction()

function(_gk_scalar name out)
  set(spelling "")
  if(name MATCHES "^i(8|16|32|64)$")
    set(spelling "int${CMAKE_MATCH_1}_t")
  elseif(name MATCHES "^u(8|16|32|64)$")
    set(spelling "uint${CMAKE_MATCH_1}_t")
  elseif(name STREQUAL "isize")
    set(spelling "ptrdiff_t")
  elseif(name STREQUAL "usize")
    set(spelling "size_t")
  elseif(name STREQUAL "f32")
    set(spelling "float")
  elseif(name STREQUAL "f64")
    set(spelling "double")
  elseif(name STREQUAL "bool")
    set(spelling "bool")
  endif()
  set(${out} "${spelling}" PARENT_SCOPE)
endfunction()

# The bare C++ spelling of the argument `arg` (its JSON), or "" for one
# C++ cannot take.
function(_gk_arg arg out)
  string(JSON type GET "${arg}" type)
  string(JSON pass ERROR_VARIABLE none GET "${arg}" pass)
  if(none)
    set(pass "")
  endif()
  _gk_scalar("${type}" spelling)
  if(type STREQUAL "str")
    set(spelling "string_view")
  elseif(type STREQUAL "bytes")
    set(spelling "bytes_view")
  elseif(type STREQUAL "bytes_mut")
    set(spelling "bytes_mut")
  elseif(type STREQUAL "object")
    string(JSON kind GET "${arg}" kind)
    if(pass STREQUAL "lent")
      set(spelling "lent<${kind}>")
    else()
      set(spelling "object<${kind}>")
    endif()
  elseif(type MATCHES "^(value|map|list)$")
    set(by_borrowed_value "view")
    set(by_borrowed_map "map_view")
    set(by_borrowed_list "list_view")
    set(by_taken_value "value")
    set(by_taken_map "map")
    set(by_taken_list "list")
    set(by_lent_value "node")
    set(by_lent_map "map_ref")
    set(by_lent_list "list_ref")
    set(spelling "${by_${pass}_${type}}")
  endif()
  set(${out} "${spelling}" PARENT_SCOPE)
endfunction()

function(_gk_answer slot out)
  string(JSON answer ERROR_VARIABLE none GET "${slot}" answer)
  if(none)
    set(${out} "void" PARENT_SCOPE)
    return()
  endif()
  string(JSON type GET "${answer}" type)
  _gk_scalar("${type}" spelling)
  if(type STREQUAL "text")
    set(spelling "string")
  elseif(type MATCHES "^(value|map|list)$")
    set(spelling "${type}")
  elseif(type STREQUAL "object")
    string(JSON kind GET "${answer}" kind)
    set(spelling "object<${kind}>")
  endif()
  set(${out} "${spelling}" PARENT_SCOPE)
endfunction()

foreach(var HEADER DESCRIPTION)
  if(NOT ${var} OR NOT EXISTS "${${var}}")
    message(FATAL_ERROR "-D${var}=<file> names no file: '${${var}}'")
  endif()
endforeach()
file(READ "${DESCRIPTION}" description)
file(READ "${HEADER}" text)
# One pass, so whichever comment opens first is the one removed: a `//`
# inside a block comment, or a `/*` after a line comment's `//`.
string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/|//[^\n]*" "" text "${text}")
string(REGEX REPLACE "#[^\n]*" "" text "${text}")
string(REPLACE ";" " " text "${text}")
string(REGEX REPLACE "[ \t\r\n]+" " " text "${text}")

# The described kind named `kname`, or "".
function(_gk_described kname out)
  set(found "")
  string(JSON n LENGTH "${description}" kinds)
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(k RANGE ${last})
      string(JSON this GET "${description}" kinds ${k} name)
      if(this STREQUAL kname)
        string(JSON found GET "${description}" kinds ${k})
      endif()
    endforeach()
  endif()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

# Every declaration first: a `_NAMED` kind is described under its given
# name, and its struct's name is what `object<>` and `lent<>` say.
set(declarations "")
set(renames "")
set(at 0)
while(TRUE)
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(REGEX MATCH "(^|[^A-Za-z0-9_])GUATIAO_(OBJECT_)?KIND(_NAMED)? *\\(" found "${rest}")
  if(NOT found)
    break()
  endif()
  set(object FALSE)
  if(CMAKE_MATCH_2)
    set(object TRUE)
  endif()
  set(named FALSE)
  if(CMAKE_MATCH_3)
    set(named TRUE)
  endif()
  string(FIND "${rest}" "${found}" offset)
  string(LENGTH "${found}" flen)
  math(EXPR open "${at} + ${offset} + ${flen}")
  _gk_balanced("${text}" ${open} inner at)
  _gk_split("${inner}" parts)
  list(POP_FRONT parts name)
  set(kname "${name}")
  if(named)
    list(POP_FRONT parts kname)
    string(REGEX REPLACE "^\"(.*)\"$" "\\1" kname "${kname}")
  endif()
  list(POP_FRONT parts vtable)
  list(LENGTH declarations i)
  set(decl_${i}_name "${name}")
  set(decl_${i}_kname "${kname}")
  set(decl_${i}_object ${object})
  set(decl_${i}_slots "${parts}")
  list(APPEND declarations ${i})
  if(NOT kname STREQUAL name)
    list(APPEND renames "${name}=${kname}")
  endif()
endwhile()

set(problems "")
set(slots_seen 0)
list(LENGTH declarations kinds_seen)
foreach(i IN LISTS declarations)
  set(name "${decl_${i}_name}")
  set(kname "${decl_${i}_kname}")
  set(object ${decl_${i}_object})
  _gk_described("${kname}" kind)
  if(NOT kind)
    list(APPEND problems "${name}: no kind named ${kname} is described")
    continue()
  endif()
  string(JSON is_object GET "${kind}" object)
  if(is_object AND NOT object)
    list(APPEND problems "${name}: an object kind, declared with GUATIAO_KIND rather than GUATIAO_OBJECT_KIND")
  elseif(object AND NOT is_object)
    list(APPEND problems "${name}: not an object kind, declared with GUATIAO_OBJECT_KIND")
  endif()
  string(JSON nslots LENGTH "${kind}" slots)

  set(declared "")
  foreach(tuple IN LISTS decl_${i}_slots)
    string(REGEX REPLACE "^\\((.*)\\)$" "\\1" tuple "${tuple}")
    string(FIND "${tuple}" "," c1)
    string(SUBSTRING "${tuple}" 0 ${c1} flag)
    math(EXPR c1 "${c1} + 1")
    string(SUBSTRING "${tuple}" ${c1} -1 tail)
    string(FIND "${tail}" "," c2)
    string(SUBSTRING "${tail}" 0 ${c2} field)
    math(EXPR c2 "${c2} + 1")
    string(SUBSTRING "${tail}" ${c2} -1 signature)
    string(STRIP "${flag}" flag)
    string(STRIP "${field}" field)
    list(APPEND declared "${field}")
    math(EXPR slots_seen "${slots_seen} + 1")

    set(slot "")
    if(nslots GREATER 0)
      math(EXPR last "${nslots} - 1")
      foreach(s RANGE ${last})
        string(JSON sname GET "${kind}" slots ${s} name)
        if(sname STREQUAL field)
          string(JSON slot GET "${kind}" slots ${s})
        endif()
      endforeach()
    endif()
    if(NOT slot)
      list(APPEND problems "${name}.${field}: no slot of that name is described")
      continue()
    endif()
    string(JSON required GET "${slot}" required)
    if(required AND NOT flag STREQUAL "required")
      list(APPEND problems "${name}.${field}: described required, declared ${flag}")
    elseif(NOT required AND NOT flag STREQUAL "optional")
      list(APPEND problems "${name}.${field}: described optional, declared ${flag}")
    endif()

    _gk_answer("${slot}" answer)
    if(NOT answer)
      set(answer "<no C++ answer>")
    endif()
    set(args "")
    string(JSON nargs LENGTH "${slot}" args)
    if(nargs GREATER 0)
      math(EXPR last "${nargs} - 1")
      foreach(a RANGE ${last})
        string(JSON arg GET "${slot}" args ${a})
        _gk_arg("${arg}" spelled)
        if(NOT spelled)
          string(JSON aname GET "${arg}" name)
          set(spelled "<${aname}: no C++ argument>")
        endif()
        list(APPEND args "${spelled}")
      endforeach()
    endif()
    list(JOIN args "," args)
    set(expected "${answer}(${args})")
    _gk_bare("${signature}" got)
    # An object of a `_NAMED` kind is spelled by its struct's name.
    foreach(rename IN LISTS renames)
      string(REPLACE "=" ";" pair "${rename}")
      list(GET pair 0 struct)
      list(GET pair 1 described_as)
      string(REPLACE "object<${struct}>" "object<${described_as}>" got "${got}")
      string(REPLACE "lent<${struct}>" "lent<${described_as}>" got "${got}")
    endforeach()
    if(NOT got STREQUAL expected)
      list(APPEND problems "${name}.${field}: declared ${got}, described ${expected}")
    endif()
  endforeach()

  if(nslots GREATER 0)
    math(EXPR last "${nslots} - 1")
    foreach(s RANGE ${last})
      string(JSON sname GET "${kind}" slots ${s} name)
      if(NOT sname IN_LIST declared)
        list(APPEND problems "${name}.${sname}: described, not declared")
      endif()
    endforeach()
  endif()
endforeach()

if(kinds_seen EQUAL 0)
  list(APPEND problems "no GUATIAO_KIND or GUATIAO_OBJECT_KIND (or their _NAMED forms) in the header")
endif()
if(problems)
  list(JOIN problems "\n  " listed)
  message(FATAL_ERROR "${HEADER} disagrees with ${DESCRIPTION}:\n  ${listed}")
endif()
message(STATUS "${kinds_seen} kinds and ${slots_seen} slots agree with ${DESCRIPTION}")
